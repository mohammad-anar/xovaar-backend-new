# ==========================================
# XOVAAR BACKEND PRODUCTION ENVIRONMENT (.env)
# Place this file in your VPS or pass via docker --env-file
# ==========================================

NODE_ENV=production
PORT=5002

# MongoDB Atlas or Self-hosted Replica Set Connection URI
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/xovaar_db?retryWrites=true&w=majority"

# Security & Password Hashing
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET="generate_a_secure_random_jwt_access_secret_string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="generate_a_secure_random_jwt_refresh_secret_string"
JWT_REFRESH_EXPIRES_IN="30d"

# Domain & CORS Origins (allow xovaar.com and www.xovaar.com)
FRONTEND_URL="https://xovaar.com"
CORS_ORIGIN="https://xovaar.com,https://www.xovaar.com,http://localhost:3000,http://localhost:3002"

# Redis Sliding Window Rate Limiting (Optional - falls back to in-memory if empty)
REDIS_URL="redis://127.0.0.1:6379"

# SMTP Mail Server for OTP & Password Recovery
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="ai.anarul4232@gmail.com"
SMTP_PASS="your_16_digit_google_app_password"
SMTP_FROM='"XOVAAR Security" <ai.anarul4232@gmail.com>'
